[flake8]
max-line-length = 100

extend-ignore =
    E265,
    E501,
    E203,
    W503,

per-file-ignores =
    django_settings/asgi.py:E402
    django_settings/settings.py:E402
    graph_models.py:E402


exclude =
    __pycache__,
    .git,
    ./venv/,
    ./node_modules/,
    ./monitoring_app/migrations/,
    ./staticroot/,
    ./static/,
    ./out/,
    ./media/,
    ./graphify-out/,
    ./models/
