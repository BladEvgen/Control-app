# Шаблон для локальной разработки через docker-compose.
# Скопируйте в backend/.env.docker и заполните своими значениями:
#   cp backend/.env.docker.example backend/.env.docker
#
# Отличие от обычного backend/.env (нативный запуск): DB_HOST/REDIS_HOST
# указывают на имена сервисов в docker-сети (mysql/postgres, redis),
# а не localhost.

SECRET_KEY="django-insecure-CHANGE-ME"
MAIN_IP="http://localhost:8000"

# DB_TYPE=mysql или postgres — должен совпадать с выбранным профилем
# docker compose --profile mysql|postgres up -d
DB_TYPE="mysql"
DB_NAME="control_app"
DB_USER="control_app"
DB_PASSWORD="control_app"
DB_HOST="mysql"
DB_PORT=3306

REDIS_HOST="redis"
REDIS_PORT=6379

EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
EMAIL_HOST=""
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL=""

API_URL=""
API_KEY=""

SECRET_API=""
X_API_KEY=""
NO_ALBUMENTATIONS_UPDATE=1

ATTENDANCE_ROOT="/app/media/control_image"
ATTENDANCE_WRITE_HMAC_SECRET="dev-secret-change-me"
ATTENDANCE_WRITE_HMAC_TTL_SECONDS=300
